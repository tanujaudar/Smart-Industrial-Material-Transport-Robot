# --- Four structural steel columns, each physically meeting a roof-frame corner ---
# Columns reach from the factory floor (z=0) into the roof beams; wider connector
# plates make each of the four joints clearly visible from the simulation viewpoint.
Solid { translation -2.82 1.82 1.325 children [ Shape { appearance PBRAppearance { baseColor 0.20 0.22 0.24 roughness 0.78 metalness 0.55 } geometry Box { size 0.16 0.16 2.65 } } ] name "ceiling_support_column_front_left" }
Solid { translation 2.82 1.82 1.325 children [ Shape { appearance PBRAppearance { baseColor 0.20 0.22 0.24 roughness 0.78 metalness 0.55 } geometry Box { size 0.16 0.16 2.65 } } ] name "ceiling_support_column_front_right" }
Solid { translation -2.82 -1.82 1.325 children [ Shape { appearance PBRAppearance { baseColor 0.20 0.22 0.24 roughness 0.78 metalness 0.55 } geometry Box { size 0.16 0.16 2.65 } } ] name "ceiling_support_column_back_left" }
Solid { translation 2.82 -1.82 1.325 children [ Shape { appearance PBRAppearance { baseColor 0.20 0.22 0.24 roughness 0.78 metalness 0.55 } geometry Box { size 0.16 0.16 2.65 } } ] name "ceiling_support_column_back_right" }
# Visible steel joint blocks bridge the top of each column into the perimeter frame.
Solid { translation -2.82 1.82 2.635 children [ Shape { appearance PBRAppearance { baseColor 0.24 0.26 0.28 roughness 0.72 metalness 0.62 } geometry Box { size 0.26 0.26 0.16 } } ] name "ceiling_joint_front_left" }
Solid { translation 2.82 1.82 2.635 children [ Shape { appearance PBRAppearance { baseColor 0.24 0.26 0.28 roughness 0.72 metalness 0.62 } geometry Box { size 0.26 0.26 0.16 } } ] name "ceiling_joint_front_right" }
Solid { translation -2.82 -1.82 2.635 children [ Shape { appearance PBRAppearance { baseColor 0.24 0.26 0.28 roughness 0.72 metalness 0.62 } geometry Box { size 0.26 0.26 0.16 } } ] name "ceiling_joint_back_left" }
Solid { translation 2.82 -1.82 2.635 children [ Shape { appearance PBRAppearance { baseColor 0.24 0.26 0.28 roughness 0.72 metalness 0.62 } geometry Box { size 0.26 0.26 0.16 } } ] name "ceiling_joint_back_right" }

